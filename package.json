{
  "name": "my-game",
  "version": "0.1.1",
  "private": true,
  "description": "A short description.",
  "keywords": [],
  "license": "MIT",
  "author": "Your Name <you@example.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-name/my-game.git"
  },
  "bugs": {
    "url": "https://github.com/your-name/my-game/issues"
  },
  "homepage": "https://github.com/your-name/my-game#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    }
  },
  "sideEffects": false,
  "scripts": {
    "dev": "pnpm -C apps/web exec vite",
    "build": "pnpm -C apps/web exec vite build",
    "clean": "node scripts/clean.mjs apps/web/dist coverage .package .tsbuild .eslintcache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:related": "vitest related --run",
    "agents:sync": "node scripts/sync-agents.mjs",
    "agents:check": "node scripts/sync-agents.mjs --check",
    "repo:labels": "node scripts/sync-labels.mjs",
    "check:staged": "node scripts/check-staged.mjs",
    "check:quick": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "check:source": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run build",
    "check": "pnpm run check:source",
    "fix": "eslint . --fix && prettier --write .",
    "hooks:install": "lefthook install",
    "bootstrap:e2e": "node scripts/verify-bootstrap.mjs",
    "bootstrap:check": "node scripts/verify-bootstrap.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "lefthook": "^2.2.1",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.11"
  }
}
