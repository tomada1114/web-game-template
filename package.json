{
  "name": "my-package",
  "version": "0.1.1",
  "description": "A short description.",
  "keywords": [],
  "license": "MIT",
  "author": "Your Name <you@example.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-name/my-package.git"
  },
  "bugs": {
    "url": "https://github.com/your-name/my-package/issues"
  },
  "homepage": "https://github.com/your-name/my-package#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "clean": "node scripts/clean.mjs dist coverage .package .eslintcache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:related": "vitest related --run",
    "repo:labels": "node scripts/sync-labels.mjs",
    "check:staged": "node scripts/check-staged.mjs",
    "check:quick": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "check:source": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run build",
    "check": "pnpm run check:source",
    "fix": "eslint . --fix && prettier --write .",
    "hooks:install": "lefthook install",
    "bootstrap:e2e": "node scripts/verify-bootstrap.mjs",
    "bootstrap:check": "node scripts/verify-bootstrap.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "lefthook": "^2.1.10",
    "prettier": "3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
