# Dependencies
node_modules/

# Build output: every `dist/` (apps/web/dist among them), and the
# declarations `tsc -b` emits so one workspace program can reference another.
dist/
.tsbuild/
*.tgz

# Test and coverage output
coverage/
test-results/
playwright-report/

# Packaging scratch directory. `pnpm clean` removes it.
.package/

# Tool caches
.eslintcache
*.tsbuildinfo
__pycache__/
*.pyc
*.pyo

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code: personal overrides stay local, shared config is tracked
.claude/settings.local.json
# Claude Code: agent worktrees are full checkouts, never part of this one
.claude/worktrees/

# Environment variables (example files are tracked on purpose)
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Logs
*.log

# OS
.DS_Store
Thumbs.db
