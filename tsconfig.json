{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Repository automation (bootstrap, package checks, agent skills) must run
    // on plain Node before `pnpm install`, so it is authored as `.mjs`.
    // Checking those files here is what makes "typecheck covers scripts" true.
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "tests",
    "scripts",
    ".agents/skills",
    ".claude/skills",
    "*.ts",
    "*.mts",
    "*.mjs",
    // A Vite config runs in Node, so it is checked here rather than in its
    // app's browser-only program.
    "apps/*/vite.config.ts"
  ],
  // `.claude/skills/` is a generated, committed mirror of `.agents/skills/`
  // (`pnpm agents:sync`): every skill lives at `.claude/skills/<name>/...`,
  // one full subdirectory per skill, with no hand-maintained list anywhere
  // (scripts/sync-agents.mjs walks `.agents/skills/` dynamically). Type-
  // checking both copies of a byte-identical mirrored file reports the same
  // diagnostic twice, at a path nobody may edit, so this glob excludes
  // anything *nested inside* an immediate subdirectory of `.claude/skills/`
  // -- for every skill, present or future, without naming one -- while still
  // type-checking a hypothetical Codex-only file added directly under
  // `.claude/skills/` itself (outside any subdirectory) -- unlike
  // eslint.config.mjs's globalIgnores and .prettierignore, which ignore the
  // whole `.claude/skills/` tree and do not draw that distinction.
  //
  // The exact shape matters: `.claude/skills/*/**` (a single `*` segment
  // followed by `/**`) was tried first and rejected -- empirically, via
  // `tsc --showConfig`/`ts.parseJsonConfigFileContent`, it also swallows a
  // bare top-level file directly under `.claude/skills/` (behaving like the
  // bare `.claude/skills/**`), which would violate the invariant above.
  // `.claude/skills/*/**/*` requires at least one path segment *after* the
  // subdirectory name, so it only matches paths nested inside a subdirectory
  // and never a file sitting directly in `.claude/skills/`.
  //
  // A `tests/fixtures/` file is malformed on purpose, so type-checking it
  // reports the very defect a test asserts on.
  "exclude": [".claude/skills/*/**/*", "tests/fixtures/**"],
  // `pnpm typecheck` is `tsc -b` on this file: it checks every workspace
  // program below, each under its own runtime, then this one.
  "references": [
    { "path": "packages/core" },
    { "path": "packages/core/test" },
    { "path": "apps/web" },
    { "path": "apps/web/test" }
  ]
}
