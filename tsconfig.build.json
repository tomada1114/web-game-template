{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true,
    "sourceMap": true,

    // `src/` is deliberately kept out of the tarball, so a map that only
    // referenced `../src/*.ts` would resolve to nothing for a consumer.
    // Embedding the sources makes every published map self-contained.
    "inlineSources": true,

    // Off because TypeScript honours `inlineSources` for `.js.map` only: a
    // `.d.ts.map` always references `../src/*.ts` by path, so every one of them
    // would ship dangling, so the build emits none.
    "declarationMap": false,
    "isolatedDeclarations": true,

    // The published artifact is TypeScript output only; repository automation
    // never ships.
    "allowJs": false,
    "checkJs": false,

    // `src/` may use `node:` builtins. The explicit `lib` keeps browser-only
    // globals out, so a DOM reference fails the build instead of silently
    // narrowing where the code can run.
    "types": ["node"],
    "lib": ["ES2023"]
  },
  "include": ["src"],
  "exclude": ["tests", "scripts", "**/*.test.ts"]
}
