{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "../../.tsbuild/web",
    "tsBuildInfoFile": "../../.tsbuild/web.tsbuildinfo",
    "rootDir": "src",
    // Vite, not Node, resolves this package's imports.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"]
  },
  "include": ["src"],
  "references": [{ "path": "../../packages/core" }]
}
